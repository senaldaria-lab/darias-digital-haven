import { ArrowUpRight } from "lucide-react";

interface AssistantCardProps {
  name: string;
  role: string;
  image: string;
  actions: string[];
  accent?: "warm" | "cool" | "neutral";
  index?: number;
}

const accents = {
  warm: {
    bg: "linear-gradient(165deg, oklch(0.995 0.005 82) 0%, oklch(0.965 0.024 80) 100%)",
    halo: "radial-gradient(120% 70% at 50% 100%, oklch(0.94 0.032 83 / 0.5), transparent 65%)",
    tag: "oklch(0.62 0.048 80)",
  },
  cool: {
    bg: "linear-gradient(165deg, oklch(0.995 0.003 80) 0%, oklch(0.972 0.012 78) 100%)",
    halo: "radial-gradient(120% 70% at 50% 100%, oklch(0.96 0.015 80 / 0.48), transparent 65%)",
    tag: "oklch(0.58 0.028 70)",
  },
  neutral: {
    bg: "linear-gradient(165deg, oklch(0.997 0.002 82) 0%, oklch(0.978 0.007 80) 100%)",
    halo: "radial-gradient(120% 70% at 50% 100%, oklch(0.97 0.01 80 / 0.4), transparent 65%)",
    tag: "oklch(0.55 0.02 72)",
  },
};

export function AssistantCard({ name, role, image, actions, accent = "neutral", index = 0 }: AssistantCardProps) {
  const a = accents[accent];
  return (
    <article className="group relative flex flex-col rounded-[28px] glass-lift overflow-hidden transition-all duration-500 hover:-translate-y-1.5">
      {/* portrait stage */}
      <div className="relative h-[380px] overflow-hidden">
        <div aria-hidden className="absolute inset-3 rounded-[24px]" style={{ background: a.bg }} />
        <div aria-hidden className="absolute inset-3 rounded-[24px] opacity-60 mix-blend-overlay noise" />
        {/* arc lines */}
        <svg aria-hidden className="absolute inset-3 w-[calc(100%-1.5rem)] h-[calc(100%-1.5rem)] opacity-30" viewBox="0 0 200 380" preserveAspectRatio="none">
          <ellipse cx="100" cy="380" rx="160" ry="80" fill="none" stroke="currentColor" strokeWidth="0.5" />
          <ellipse cx="100" cy="380" rx="120" ry="60" fill="none" stroke="currentColor" strokeWidth="0.5" />
          <ellipse cx="100" cy="380" rx="80" ry="40" fill="none" stroke="currentColor" strokeWidth="0.5" />
        </svg>
        <div aria-hidden className="absolute inset-3 rounded-[24px] pointer-events-none" style={{ background: a.halo }} />

        <img
          src={image}
          alt={`${name}, ${role}`}
          loading="lazy"
          width={512}
          height={1024}
          className="absolute inset-x-0 bottom-0 mx-auto h-[370px] w-auto object-contain object-bottom drop-shadow-[0_30px_30px_oklch(0.3_0.02_60/0.18)] transition-transform duration-700 group-hover:scale-[1.04]"
        />

        {/* status */}
        <div className="absolute top-5 left-5 flex items-center gap-2 rounded-full glass-solid px-3 py-1.5 text-[10.5px] font-medium text-foreground/80 uppercase tracking-wider">
          <span className="relative pulse-dot inline-block h-1.5 w-1.5 rounded-full bg-emerald-500" />
          готовий допомогти
        </div>

        {/* index chip */}
        <div className="absolute top-5 right-5 rounded-full glass-solid px-2.5 py-1 text-[10px] font-medium" style={{ color: a.tag }}>
          0{index + 1}
        </div>
      </div>

      {/* meta */}
      <div className="relative px-6 pt-6 pb-6 space-y-5">
        <div className="flex items-end justify-between gap-3">
          <div>
            <h3 className="font-display text-[2rem] leading-none text-foreground">{name}</h3>
            <p className="mt-2 text-[13px] text-muted-foreground tracking-wide">{role}</p>
          </div>
          <button aria-label={`Відкрити ${name}`} className="h-9 w-9 rounded-full btn-glass grid place-items-center text-foreground/70">
            <ArrowUpRight className="h-4 w-4" strokeWidth={1.6} />
          </button>
        </div>

        <div className="flex flex-col gap-2">
          {actions.map((act) => (
            <button
              key={act}
              className="group/btn relative flex items-center justify-between rounded-2xl btn-glass px-4 py-2.5 text-[13px] text-foreground/85 hover:text-foreground"
            >
              <span>{act}</span>
              <span className="text-[10px] uppercase tracking-[0.18em] text-muted-foreground group-hover/btn:text-foreground/60 transition">
                →
              </span>
            </button>
          ))}
        </div>
      </div>
    </article>
  );
}
